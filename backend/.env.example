# Copy to backend/.env and adjust.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://dentassist:dentassist@localhost:5432/dentassist

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Password given to every demo login by `python -m app.seed`
DEMO_PASSWORD=Demo@1234
